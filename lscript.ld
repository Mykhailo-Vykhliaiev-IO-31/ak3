/*
 * Скрипт лінкера для STM32.
 * Описує області пам'яті FLASH та RAM.
 */

MEMORY
{
    /*
     * FLASH - пам'ять для зберігання програмного коду.
     * Для STM32 вона починається з адреси 0x08000000.
     */
    FLASH (rx) : ORIGIN = 0x08000000, LENGTH = 1M

    /*
     * RAM - оперативна пам'ять мікроконтролера.
     * Починається з адреси 0x20000000.
     */
    RAM (rxw) : ORIGIN = 0x20000000, LENGTH = 128K
}

/*
 * Початок стеку встановлюється в кінець RAM.
 */
__stack_start = ORIGIN(RAM) + LENGTH(RAM);
